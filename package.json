{
  "name": "dsh-motrix-download",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: route model download requests to the local Motrix (aria2) app, with a built-in direct HTTP fallback.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "motrix",
    "aria2",
    "download"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siselea/dsh-motrix-download.git"
  },
  "homepage": "https://github.com/Siselea/dsh-motrix-download#readme",
  "bugs": {
    "url": "https://github.com/Siselea/dsh-motrix-download/issues"
  },
  "author": "Siselea",
  "license": "MIT"
}
